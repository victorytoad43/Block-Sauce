component Grabber
{
    asset_ref<GrabConfig> Config;
    EntityRef Held;
    [HideInInspector] FPQuaternion HeldRotationOffset;
    [HideInInspector] FP SwingYaw;
    [HideInInspector] FP SwingPitch;
    [HideInInspector] bool IsAiming;
    [HideInInspector] FP AimPitch;
}

component Grabbable
{
    [HideInInspector] EntityRef Holder;
    [HideInInspector] EntityRef LastHolder;
    // The block's own physics layer, kept while aiming moves it to the AimedBlock layer.
    [HideInInspector] Int32 SolidLayer;
    // Until this runs out, a thrown block passes through its LastHolder and through the bodies it overlapped when
    // thrown (an aimed block touches nothing, so it can be released inside another block).
    [HideInInspector] FrameTimer ThrowClear;
    [HideInInspector] array<EntityRef>[4] ThrowClearOf;
}

event Grabbed
{
    EntityRef Entity;
    EntityRef Held;
}

event Dropped
{
    EntityRef Entity;
    EntityRef Held;
}

event Placed
{
    EntityRef Entity;
    EntityRef Held;
}

event Thrown
{
    EntityRef Entity;
    EntityRef Held;
    FPVector3 Velocity;
    bool Jumpshot;
}

event ObjectImpact
{
    EntityRef Entity;
    FPVector3 Position;
    FP Speed;
}

signal DropHeld(EntityRef holder);
