enum MatchState
{
    Lobby,
    Countdown,
    Playing,
    RoundEnd,
    Results
}

struct SandboxBlockHome
{
    FPVector3 Position;
    FPQuaternion Rotation;
}

singleton component Match
{
    asset_ref<GameModeConfig> Mode;
    [HideInInspector] MatchState State;
    [HideInInspector] FrameTimer Timer;
    [HideInInspector] PlayerRef Winner;
    [HideInInspector] bool SandboxRecorded;
    [HideInInspector] list<SandboxBlockHome> SandboxBlocks;
    // The room's setting: when false (the default), bots fill the empty player slots as a match starts.
    [HideInInspector] bool LeaveSlotsEmpty;
}

event MatchStateChanged
{
    MatchState State;
    PlayerRef Winner;
}

// A map marker where a block appears at match start, for the player on spawn point number Slot (in map order). Home
// marks the block a player's tower is meant to start on: bots build there, and a fallen block returns to it. A map
// without markers gives each player a row of blocks in front of their spawn instead.
component BlockSpawnPoint
{
    int Slot;
    bool Home;
}
