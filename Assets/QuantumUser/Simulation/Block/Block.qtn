enum StackState
{
    Loose,
    Settling,
    Counted
}

component Block
{
    [HideInInspector] PlayerRef Owner;
    [HideInInspector] StackState Stack;
    // 0..1 while settling; a block counts toward its owner's score when it reaches 1.
    [HideInInspector] FP StackProgress;
    // 0 = resting on the ground; NotStacked when the block isn't part of an owned stack.
    [HideInInspector] byte StackLevel;
    // The owned block this one rests on (none for a ground block), and the ground block of its stack.
    [HideInInspector] EntityRef Below;
    [HideInInspector] EntityRef Base;
    [HideInInspector] bool Supported;
    [HideInInspector] bool HasAbove;
}

event BlockSettleStarted
{
    EntityRef Block;
    PlayerRef Owner;
}

event BlockSettleReset
{
    EntityRef Block;
    PlayerRef Owner;
}

event BlockCounted
{
    EntityRef Block;
    PlayerRef Owner;
    byte StackLevel;
}

event BlockUncounted
{
    EntityRef Block;
    PlayerRef Owner;
}
