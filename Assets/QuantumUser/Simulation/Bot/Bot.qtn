// What a bot is doing; the brain sets a task and reads its status (BotActions carries it out).
enum BotTaskType
{
    None,
    // Walk to Point.
    GoTo,
    // Walk to the Target block and pick it up (any block picked up counts; Target becomes it).
    Fetch,
    // Carry the held block to the Target block and place it on top.
    PlaceOn,
    // Throw the held block at the Target entity.
    ThrowAt,
    // Carry the held block to the Target vat, dunk it and lift it out.
    Dunk,
    // Carry the held block to Point (or, with no Point, stay put) and set it down.
    Drop,
    // Run at the Target character and slide into it, so the hit staggers it and it drops what it holds.
    SlideTackle
}

enum BotTaskStatus
{
    Running,
    Done,
    Failed
}

// A character the simulation drives. It holds a player slot nobody is connected to, so ownership, teams, colors and
// scoring treat it as a player, and its brain writes that slot's Player.Input instead of a client sending it.
component Bot
{
    // The yaw, in degrees, the bot is looking and walking toward.
    [HideInInspector] FP Heading;
    // The ground block the bot builds its tower on, chosen by its brain.
    [HideInInspector] EntityRef Home;

    [HideInInspector] BotTaskType Task;
    [HideInInspector] BotTaskStatus Status;
    [HideInInspector] EntityRef Target;
    [HideInInspector] FPVector3 Point;
    // The block the bot was carrying when it placed or threw it, to check where it went.
    [HideInInspector] EntityRef Carried;
    // The task's own progress (which step of a place or dunk it is on) and how long the step or task may take.
    [HideInInspector] byte Step;
    [HideInInspector] byte Attempts;
    [HideInInspector] FrameTimer StepTimer;
    [HideInInspector] FrameTimer TaskTimer;
    // A moment's hesitation before the task starts, so bots don't react with machine speed.
    [HideInInspector] FrameTimer ThinkTimer;
    // A block the bot failed to fetch (out of reach, say), which it leaves alone until the timer runs out.
    [HideInInspector] EntityRef Unreachable;
    [HideInInspector] FrameTimer UnreachableTimer;

    // Stuck detection: where the bot was at the last check, and a detour heading it follows for a moment when stuck.
    [HideInInspector] FPVector3 ProgressPosition;
    [HideInInspector] FrameTimer ProgressTimer;
    [HideInInspector] FP DetourYaw;
    [HideInInspector] FrameTimer DetourTimer;

    // Pathfinding on the map's navmesh (BotNavigation): the point the bot is walking to next, the target the path was
    // found for, when to look again, and whether the point is the far end of a jump link (and so worth a jump).
    [HideInInspector] FPVector3 PathPoint;
    [HideInInspector] FPVector3 PathTarget;
    [HideInInspector] FrameTimer PathTimer;
    [HideInInspector] bool PathJump;
    [HideInInspector] bool HasPath;

    // Slides: no new slide tackle until TackleTimer runs out; no travel slide until TravelSlideTimer does.
    [HideInInspector] FrameTimer TackleTimer;
    [HideInInspector] FrameTimer TravelSlideTimer;
}

event BotAdded
{
    PlayerRef Player;
}

// A bot's slide tackle ended after a slide or a hit: whether it slid (or body-checked the target on the run), whether
// it hit (the target was staggered or knocked down), and whether the target lost the block it was holding.
event BotTackleEnded
{
    EntityRef Bot;
    EntityRef Target;
    bool Slid;
    bool Hit;
    bool Dropped;
}

event BotRemoved
{
    PlayerRef Player;
}
