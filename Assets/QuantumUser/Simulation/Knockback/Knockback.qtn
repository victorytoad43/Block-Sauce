component Knockbackable
{
    asset_ref<KnockbackConfig> Config;
    // The strongest hit from this tick's collisions, applied after the physics step (see KnockbackSystem).
    FPVector3 PendingImpulse;
    EntityRef PendingSource;
}

event KnockedBack
{
    EntityRef Entity;
    EntityRef Source;
    nothashed FPVector3 Impulse;
    bool Staggered;
}

signal ApplyKnockback(EntityRef target, FPVector3 impulse, EntityRef source);
